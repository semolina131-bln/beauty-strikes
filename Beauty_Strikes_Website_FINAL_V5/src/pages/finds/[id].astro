---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductArt from '../../components/ProductArt.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import DisclosureNote from '../../components/DisclosureNote.astro';
import ProductCard from '../../components/ProductCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getProducts, getArticles, CATEGORY_SHORT, formatDate, type Product } from '../../lib/content';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}
const { product } = Astro.props as { product: Product };
const d = product.data;
const isPlaceholder = d.status === 'placeholder';
const related = (await getProducts()).filter((p) => p.data.category === d.category && p.id !== product.id).slice(0, 4);
const guides = (await getArticles()).filter((a) => a.data.relatedProducts.includes(product.id) || a.data.category === d.category).slice(0, 2);
const title = `${d.brand} ${d.name}`;
---
<BaseLayout
  title={isPlaceholder ? `Placeholder: ${title}` : `${title} — What It Is & Who It Suits`}
  description={d.summary.slice(0, 155)}
  noindex={isPlaceholder}
  jsonLd={[{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Beauty Finds', item: new URL('/finds/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: new URL(`/finds/${product.id}/`, Astro.site).href },
    ],
  }]}
>
  <section class="section-tight">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Beauty Finds', href: '/finds/' }, { label: title }]} />
      {isPlaceholder && (
        <p class="notice"><strong>Placeholder entry.</strong> This is a sample slot showing how a product page will look. It is not a recommendation and contains no verified product information.</p>
      )}
      <div class="pd">
        <div class="media"><ProductArt category={d.category} subcategory={d.subcategory} image={d.image} large /></div>
        <div class="info">
          <a class="cat" href={`/${d.category}/`}>{CATEGORY_SHORT[d.category]}</a>
          <p class="brand">{d.brand}</p>
          <h1>{d.name}</h1>
          <p class="lede">{d.summary}</p>
          <AffiliateButton product={product} />
          <p class="small">Last reviewed {formatDate(d.lastReviewed)}. Prices, availability and customer reviews are shown on the retailer’s site only.</p>
          {d.image.credit && <p class="small">Image: {d.image.credit}</p>}
        </div>
      </div>

      <div class="facts">
        <div><h2>Features</h2><ul>{d.features.map((f) => <li>{f}</li>)}</ul></div>
        <div><h2>Why it made the list</h2><ul>{d.pros.map((f) => <li>{f}</li>)}</ul></div>
        <div><h2>Worth knowing</h2><ul>{d.limitations.map((f) => <li>{f}</li>)}</ul></div>
      </div>
      <DisclosureNote />
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <h2 class="h">Related guides</h2>
        <div class="grid grid-2">{guides.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section-wash">
      <div class="wrap">
        <h2 class="h">More in {CATEGORY_SHORT[d.category]}</h2>
        <div class="grid grid-4">{related.map((p) => <ProductCard product={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .notice { margin-bottom: 24px; }
  .pd { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .media { border: 1.5px solid var(--midnight); overflow: hidden; }
  .cat { font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--violet); text-decoration: none; }
  .brand { margin: 14px 0 4px; font-weight: 650; color: var(--ink-3); }
  h1 { font-size: clamp(2rem, 2.6vw + 1rem, 3.1rem); line-height: 1.08; margin-bottom: .45em; }
  .small { font-size: .84rem; color: var(--ink-3); margin-top: 16px; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: clamp(56px, 6vw, 80px) 0 32px; }
  .facts > div { background: var(--surface); border: 1px solid var(--line); padding: 26px 28px; }
  .facts h2 { font-size: 1.2rem; }
  .facts ul { margin: 0; padding-left: 1.1em; color: var(--ink-2); font-size: .95rem; }
  .h { font-size: 1.8rem; margin-bottom: 24px; }
  @media (max-width: 820px) { .pd, .facts { grid-template-columns: 1fr; } }
</style>
