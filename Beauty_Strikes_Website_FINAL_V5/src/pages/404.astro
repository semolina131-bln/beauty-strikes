---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist (anymore)." noindex>
  <section class="nf">
    <div class="wrap-narrow">
      <span class="eyebrow">Error 404</span>
      <h1>This page went <span class="serif-italic">off-routine.</span></h1>
      <p class="lede">The link may be old or mistyped. Here are some good places to start again.</p>
      <div class="links">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/finds/">Beauty Finds</a>
        <a class="btn btn-ghost" href="/journal/">Journal</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { padding: clamp(64px, 12vw, 140px) 0; text-align: center;  }
  .nf .lede { margin-inline: auto; }
  h1 { margin: 16px 0; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 28px; }
</style>
