---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{c.href && i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 24px; font-size: .84rem; color: var(--ink-3); }
  li + li::before { content: '/'; margin-right: 6px; color: var(--line-strong); }
  a { color: var(--ink-2); text-decoration: none; }
  a:hover { color: var(--violet); text-decoration: underline; }
  [aria-current] { color: var(--ink-3); }
</style>
