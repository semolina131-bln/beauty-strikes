---
import { NAV } from '../config';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <details class="nav-mobile">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
        <span class="summary-text">Menu</span>
      </summary>
      <nav aria-label="Main (mobile)">
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a href="/about/">About</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(247, 245, 250, .9);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 4px; }
  .nav-desktop a, .nav-mobile a {
    position: relative; display: block; padding: 10px 12px;
    font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-2); text-decoration: none; transition: color .2s;
  }
  .nav-desktop a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px;
    background: var(--violet); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  .nav-desktop a:hover { color: var(--midnight); }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current='page']::after { transform: scaleX(1); }
  .nav-desktop a[aria-current='page'] { color: var(--midnight); }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; box-shadow: inset 0 0 0 1.5px var(--midnight);
    font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--midnight);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 5px; width: 18px; }
  .burger span { height: 2px; background: var(--plum); border-radius: 2px; transition: transform .25s; }
  .nav-mobile[open] .burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav-mobile[open] .burger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .nav-mobile nav {
    position: absolute; right: 0; top: calc(100% + 10px); width: min(84vw, 300px);
    background: var(--surface); border: 1.5px solid var(--midnight); padding: 10px;
  }
  .nav-mobile a { letter-spacing: 0; text-transform: none; font-weight: 500; padding: 12px 14px; font-family: var(--font-display); font-size: 1.3rem; color: var(--midnight); text-decoration: none; }
  .nav-mobile a[aria-current='page'] { background: var(--lavender-soft); }
  .nav-mobile li + li { border-top: 1px solid var(--line); }

  @media (max-width: 1000px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
</style>
