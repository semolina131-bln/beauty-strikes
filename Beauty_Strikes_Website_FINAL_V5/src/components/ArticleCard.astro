---
import { CATEGORY_SHORT, TEMPLATE_LABELS, formatDate, readingMinutes, type Article } from '../lib/content';
interface Props { article: Article; large?: boolean }
const { article, large = false } = Astro.props;
const d = article.data;
const accents: Record<string, string> = {
  'korean-skincare': 'var(--lavender-soft)',
  'skincare-routines': 'var(--wash-2)',
  'haircare-scalp': '#f3eaf9',
  'beauty-tools': 'var(--wash)',
};
---
<article class:list={['acard reveal', { large }]} style={`--tint:${accents[d.category]}`}>
  <a href={`/journal/${article.id}/`} class="inner">
    <div class="cover">
      {d.heroImage ? (
        <img src={d.heroImage} alt={d.heroAlt ?? ''} loading="lazy" width="800" height="600" />
      ) : (
        <span class="mark" aria-hidden="true">{TEMPLATE_LABELS[d.template].charAt(0)}</span>
      )}
      <span class="type">{TEMPLATE_LABELS[d.template]}</span>
      {d.draft && <span class="badge badge-draft draft">Draft — not public</span>}
    </div>
    <div class="text">
      <span class="cat">{CATEGORY_SHORT[d.category]}</span>
      <h3>{d.title}</h3>
      <p>{d.description}</p>
      <span class="meta">{formatDate(d.pubDate)} · {readingMinutes(article.body)} min read</span>
    </div>
  </a>
</article>

<style>
  .acard { position: relative; background: var(--surface); border: 1px solid var(--line); transition: border-color .25s; }
  .acard:hover { border-color: var(--midnight); }
  .inner { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .cover { position: relative; aspect-ratio: 16/10; background: var(--tint); display: grid; place-items: center; overflow: hidden; }
  .cover::before { content: ''; position: absolute; inset: 0; background: var(--surface); clip-path: polygon(0 100%, 100% 58%, 100% 100%); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .mark { position: relative; z-index: 1; font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 6rem; line-height: 1; color: var(--midnight); transform: translateY(-8%); }
  .type { position: absolute; z-index: 2; left: 0; top: 14px; background: var(--midnight); color: #fff; font-size: .64rem; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; padding: 6px 10px 6px 14px; }
  .draft { position: absolute; z-index: 2; right: 12px; top: 14px; }
  .text { padding: 24px 26px 28px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .cat { font-size: .66rem; font-weight: 750; letter-spacing: .18em; text-transform: uppercase; color: var(--violet); }
  h3 { margin: 0; font-size: 1.4rem; line-height: 1.2; }
  .inner:hover h3 { color: var(--violet); }
  p { margin: 0; color: var(--ink-2); font-size: .95rem; flex: 1; }
  .meta { font-size: .78rem; color: var(--ink-3); margin-top: 6px; letter-spacing: .02em; }
  .large h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  @media (min-width: 860px) {
    .large .inner { flex-direction: row; }
    .large .cover { aspect-ratio: auto; flex: 1.1; min-height: 380px; }
    .large .cover::before { clip-path: polygon(78% 0, 100% 0, 100% 100%, 92% 100%); }
    .large .text { flex: 1; justify-content: center; padding: 48px; }
  }
</style>
