---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; description: string; eyebrow?: string; heading: string; noindex?: boolean; updated?: string }
const { title, description, eyebrow, heading, noindex, updated } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <header class="p-head">
    <div class="wrap-narrow">
      <Breadcrumbs items={[{ label: heading }]} />
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{heading}</h1>
      {updated && <p class="upd">Last updated: {updated}</p>}
    </div>
  </header>
  <div class="wrap-narrow prose body"><slot /></div>
</BaseLayout>
<style>
  .p-head { padding: clamp(32px, 6vw, 68px) 0 8px; background: linear-gradient(172deg, transparent 86%, var(--wash) 86%); border-bottom: 1px solid var(--line); }
  h1 { margin: 14px 0 12px; font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .upd { font-size: .86rem; color: var(--ink-3); margin-bottom: 26px; }
  .body { padding-block: 32px 40px; }
</style>
